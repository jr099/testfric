{
  "product_vision": {
    "working_name": "PulsePlay",
    "promise": "Convert short play sessions into transparent progression and clearly governed rewards, with no hidden value mechanics.",
    "target_segments": [
      "mobile-first casual players",
      "competitive players seeking fair seasonal ladders",
      "users requiring clear value and withdrawal transparency",
      "brand partners funding sponsored rewards"
    ],
    "differentiation": [
      "five-resource economy with explicit boundaries",
      "public rulebooks for probabilities, reward rates, and season scoring",
      "separate monetization from reward-credit generation",
      "user-visible immutable ledger and exportable statements",
      "compliance center embedded in product UX"
    ],
    "value_proposition": {
      "for_players": "Predictable progression, fair competition modes, and auditable reward lifecycle.",
      "for_sponsors": "Controlled sponsored campaigns with anti-fraud safeguards and measurable engagement.",
      "for_ops_and_legal": "Versioned rule engine, complete audit trails, and compliance-by-design controls."
    },
    "core_retention_loop": [
      "claim daily tickets",
      "play 30-90s games",
      "earn coins and season xp",
      "complete missions",
      "unlock cosmetics/status and eligible reward credits via explicit objectives",
      "redeem rewards with tracked fulfillment"
    ],
    "product_philosophy": [
      "clarity over complexity",
      "skill and consistency over opaque chance",
      "user control over pressure",
      "modular architecture with domain ownership",
      "observable systems before scale"
    ],
    "trust_principles": [
      "all material rules are visible before user commitment",
      "no direct premium-to-withdrawable conversion",
      "all financial and reward events are append-only logged",
      "probabilities displayed when randomness exists",
      "all policy changes are versioned and time-scoped"
    ]
  },
  "functional_architecture": {
