      {
        "page": "Home",
        "objective": "Explain value proposition and trust guarantees in <10 seconds.",
        "sections": ["hero", "how it works", "resource explainer", "social proof with context", "compliance highlights", "faq teaser"],
        "cta": ["Create account", "Explore games", "View trust center"],
        "data": ["aggregated platform metrics", "published rulebook versions", "featured rewards"],
        "ui_components": ["hero card", "resource chips", "timeline", "metric badges", "faq accordion"]
      },
      {
        "page": "How It Works",
        "objective": "Describe lifecycle from signup to reward claim with value boundaries.",
        "sections": ["journey steps", "resource boundary matrix", "competition modes", "withdrawal prerequisites"],
        "cta": ["Start onboarding", "Read full rules"],
        "data": ["rule versions", "processing SLA"],
        "ui_components": ["stepper", "comparison table", "info callouts"]
      },
      {
        "page": "Rewards",
        "objective": "Show available reward categories and claim conditions.",
        "sections": ["digital rewards", "external rewards", "eligibility rules", "fulfillment timelines"],
        "cta": ["Browse catalog", "See claim policy"],
        "data": ["catalog summaries", "stock", "min thresholds"],
        "ui_components": ["filter chips", "reward cards", "stock indicator", "policy drawer"]
      },
      {
        "page": "Competitions",
        "objective": "Present season formats and fairness model.",
        "sections": ["season calendar", "standard vs boosted", "scoring", "prizes"],
        "cta": ["Join season", "Read competition rules"],
        "data": ["active season", "past outcomes anonymized"],
        "ui_components": ["calendar", "leaderboard preview", "rule badge"]
      },
      {
