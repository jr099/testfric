        "ui_components": ["kpi tiles", "mission list", "progress bars", "event feed"]
      },
      {
        "page": "Wallet",
        "objective": "Explain every balance change and conversion route.",
        "sections": ["resource balances", "ledger", "conversion simulator", "exports"],
        "cta": ["Convert coins", "Download statement"],
        "data": ["wallets", "ledger entries", "rate tables"],
        "ui_components": ["tabbed balances", "transaction table", "filters", "csv export"]
      },
      {
        "page": "Games",
        "objective": "Start game sessions with pre-commit clarity.",
        "sections": ["game catalog", "entry cost", "probability panel", "recent performance"],
